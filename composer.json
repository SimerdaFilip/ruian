{
    "name": "simerda/ruian",
    "description": "RÚIAN code value objects and a ČÚZK address-point geocoding client.",
    "type": "library",
    "keywords": ["ruian", "cuzk", "adresy", "address", "geocoding", "czech", "arcgis"],
    "license": "MIT",
    "authors": [
        {
            "name": "Filip Šimerda",
            "email": "filip.simerda@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Simerda\\Ruian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simerda\\Ruian\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
